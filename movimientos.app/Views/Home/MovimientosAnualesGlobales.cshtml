    function getMovimientos(anio) {
        $.get(`/api/movimientos/movimientosvirtualesanuales?anio=${anio}`, function (data) {
        
            // --- LÓGICA DE CONFIRMADOS (Sin cambios) ---
            $('#listaconfirmados').empty();
            let totalMontoreal = 0;
            let totalVirtual = 0;
        
            if (data.confirmados.length === 0) {
                $('#listaconfirmados').append('<p>No hay movimientos para esta categoría.</p>');
            } else {
                let tableConfirmados = `
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Mes</th>
                                <th>Ingresos</th>
                                <th>Egresos</th>
                                <th>Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                `;
                data.confirmados.forEach(function (movimiento) {
                    totalMontoreal += parseFloat(movimiento.saldo_proyectado);
                    tableConfirmados += `
                        <tr>
                            <td>${movimiento.mes}</td>
                            <td>${movimiento.ingresos_proyectados}</td>
                            <td>${movimiento.egresos_proyectados}</td>
                            <td>${movimiento.saldo_proyectado}</td>
                        </tr>
                    `;
                });
                tableConfirmados += '</tbody></table>';
                $('#listaconfirmados').append(tableConfirmados);
            }

            // --- LÓGICA DE VIRTUALES / ESPERADOS (Modificada) ---
            $('#listavirtuales').empty();
            if (data.virtuales.length === 0) {
                $('#listavirtuales').append('<p>No hay movimientos para esta categoría.</p>');
            } else {
                let tableVirtuales = `
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Mes</th>
                                <th>Ingresos</th>
                                <th>Egresos</th>
                                <th>Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                `;
            
                // 1. Obtener el mes actual en formato "YYYY-MM" para comparar
                const fechaActual = new Date();
                const mesActualStr = `${fechaActual.getFullYear()}-${String(fechaActual.getMonth() + 1).padStart(2, '0')}`;
            
                // 2. Variable para ir guardando el saldo del mes anterior
                let saldoAnterior = 0;

                data.virtuales.forEach(function (movimiento) {
                    // Convertimos a números para poder operar matemáticamente
                    let ingresos = parseFloat(movimiento.ingresos_proyectados);
                    let egresos = parseFloat(movimiento.egresos_proyectados);
                    let saldo = parseFloat(movimiento.saldo_proyectado);
                    let mes = movimiento.mes;

                    // 3. Si el mes del registro es estrictamente mayor al mes actual (futuro)
                    if (mes > mesActualStr) {
                        // Sumamos el saldo del mes anterior a los ingresos
                        ingresos += saldoAnterior;
                        // Recalculamos el saldo con los nuevos ingresos
                        saldo = ingresos - egresos;
                    }

                    // 4. Actualizamos el saldo anterior para la iteración del siguiente mes
                    saldoAnterior = saldo;

                    // Agregamos .toFixed(2) para que siempre muestre 2 decimales y se vea ordenado
                    tableVirtuales += `
                        <tr>
                            <td>${mes}</td>
                            <td>${ingresos.toFixed(2)}</td>
                            <td>${egresos.toFixed(2)}</td>
                            <td>${saldo.toFixed(2)}</td>
                        </tr>
                    `;
                });
            
                tableVirtuales += '</tbody></table>';
                $('#listavirtuales').append(tableVirtuales);
            }
        });
    }
    activarSwipe(anioBox,
        () => { // ↑
            anioActual++;
            anioBox.textContent = anioActual;
            getMovimientos(anioActual);
        },
        () => { // ↓
            anioActual--;
            anioBox.textContent = anioActual;
            getMovimientos(anioActual);
        }
    );
    getMovimientos(anioActual);
</script>